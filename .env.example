# Variables de entorno para TikTok Downloader
# Copia este archivo como .env y configura tus valores

# Clave secreta para Flask (generar una nueva para producción)
SECRET_KEY=tu_clave_secreta_super_segura_aqui

# Modo debug (True para desarrollo, False para producción)
DEBUG=False

# Puerto de la aplicación (Heroku usa PORT automáticamente)
PORT=5000

# Configuración de yt-dlp (opcional)
YT_DLP_OUTPUT_TEMPLATE=%(uploader)s_%(title)s.%(ext)s

# Límites de la aplicación (opcional)
MAX_FILE_SIZE_MB=100
MAX_DOWNLOADS_PER_HOUR=50